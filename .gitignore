# ── Godot ────────────────────────────────────────────────────────────────────
# Cache de importação e metadados gerados pelo editor
.godot/

# Artefatos temporários do editor (saves automáticos)
*.tmp

# Arquivos de UID são regenerados pelo Godot; não precisam ir pro git
*.uid

