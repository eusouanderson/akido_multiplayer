/android/
/ios/

# ── Exportações ──────────────────────────────────────────────────────────────
/export/
/builds/
*.pck
*.exe
*.apk
*.aab
*.dmg

# ── Arquivos de fonte / edição (não são assets do jogo) ──────────────────────
# Pixelorama
*.pxo

# Photoshop / Aseprite
*.psd
*.ase
*.aseprite

